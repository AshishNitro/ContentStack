{
  "name": "backend",
  "version": "1.0.0",
  "description": "Multi-domain blog manager backend API",
  "main": "src/app.ts",
  "scripts": {
    "start": "ts-node src/app.ts",
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "build": "tsc",
    "db:setup": "node -e \"const{Pool}=require('pg');require('dotenv').config();const fs=require('fs');const p=new Pool({connectionString:process.env.DATABASE_URL});p.query(fs.readFileSync('../database/schema.sql','utf8')).then(()=>{console.log('Schema created');p.end()}).catch(e=>{console.error(e.message);p.end()})\"",
    "db:seed": "node seed-db.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.20.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
